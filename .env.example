# Build-time credentials. Never expose these through Vite/client env variables.
BOK_ECOS_API_KEY=

# Optional SEC fair-access User-Agent override. The builder has a repository contact default.
SEC_USER_AGENT=

# Optional complete source-map override for full market rebuilds.
# Market-cap builds default to the tracked supported map in config/market-source-map.json.
MARKET_SOURCE_MAP_PATH=.private/market-source-map.json

# Historical KRX KIND + Nasdaq market-data build controls.
MARKET_DATA_FROM=2018-01-01
MARKET_DATA_TO=
KRX_KIND_REQUEST_DELAY_MS=120
NASDAQ_REQUEST_DELAY_MS=100

# Point-in-time U.S. stock market-cap build control.
SEC_REQUEST_DELAY_MS=120
