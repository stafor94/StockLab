{
  "name": "stocklab",
  "private": true,
  "version": "0.32.0",
  "type": "module",
  "description": "Historical stock trading web game deployed on GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" \"config/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "release:check": "tsx scripts/release/validate-release-metadata.ts",
    "data:check": "tsx scripts/data/validate-market-data.ts --allow-bootstrap",
    "data:kr:build": "tsx scripts/data/build-kr-market-data.ts",
    "data:kr:check": "tsx scripts/data/validate-kr-market-data.ts",
    "data:us:build": "tsx scripts/data/build-us-market-data.ts",
    "data:us:check": "tsx scripts/data/validate-us-market-data.ts",
    "data:indices:build": "tsx scripts/data/build-market-index-data.ts",
    "data:indices:check": "tsx scripts/data/validate-market-index-data.ts",
    "data:source-map:template": "tsx scripts/data/generate-source-map-template.ts",
    "data:coverage": "tsx scripts/data/report-data-coverage.ts",
    "data:fx:build": "tsx scripts/data/build-fx-data.ts",
    "data:fx:check": "tsx scripts/data/validate-fx-data.ts",
    "data:rates:build": "tsx scripts/data/build-base-rate-data.ts",
    "data:rates:check": "tsx scripts/data/validate-base-rate-data.ts",
    "data:events:check": "tsx scripts/data/validate-corporate-events.ts",
    "data:news:check": "tsx scripts/data/validate-news-data.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
