# Build-time credentials. Never expose these through Vite/client env variables.
BOK_ECOS_API_KEY=

# Private real-symbol mapping. Never commit the completed file.
MARKET_SOURCE_MAP_PATH=.private/market-source-map.json

# Korean KRX KIND build controls. No KRX API key is required.
MARKET_DATA_FROM=2018-01-01
MARKET_DATA_TO=
KRX_KIND_REQUEST_DELAY_MS=120
