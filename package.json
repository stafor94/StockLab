{
  "name": "stocklab",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Historical stock trading web game deployed on GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" \"config/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:build": "tsx scripts/data/build-market-data.ts",
    "data:check": "tsx scripts/data/validate-market-data.ts --allow-bootstrap",
    "data:fx:build": "tsx scripts/data/build-fx-data.ts",
    "data:fx:check": "tsx scripts/data/validate-fx-data.ts --allow-missing",
    "data:rates:build": "tsx scripts/data/build-base-rate-data.ts",
    "data:rates:check": "tsx scripts/data/validate-base-rate-data.ts --allow-bootstrap"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "^10.6.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "tsx": "^4.20.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
