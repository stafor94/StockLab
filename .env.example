# Build-time market data credentials. Never expose these through Vite/client env variables.
KRX_AUTH_KEY=
ALPHA_VANTAGE_API_KEY=

# Optional build controls.
MARKET_SOURCE_MAP_PATH=.private/market-source-map.json
MARKET_DATA_FROM=2018-01-01
MARKET_DATA_TO=
KRX_REQUEST_DELAY_MS=150
ALPHA_VANTAGE_REQUEST_DELAY_MS=1200
US_CALENDAR_PROBE_SYMBOL=SPY
